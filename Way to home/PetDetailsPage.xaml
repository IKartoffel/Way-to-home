<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Way_to_home.PetDetailsPage"
             BackgroundColor="#FEF8EE"
             Shell.NavBarIsVisible="False">

    <Grid RowDefinitions="Auto, *, Auto" Padding="20, 30, 20, 20">

        <!-- ШАПКА С КНОПКОЙ НАЗАД -->
        <HorizontalStackLayout Grid.Row="0" Spacing="15" Margin="0,0,0,20">
            <Border StrokeShape="RoundRectangle 20" StrokeThickness="1" Stroke="#E0E0E0" BackgroundColor="White" WidthRequest="40" HeightRequest="40" Padding="0">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnBackClicked" />
                </Border.GestureRecognizers>
                <Label Text="&lt;" FontSize="20" TextColor="#2B2D42" HorizontalOptions="Center" VerticalOptions="Center"/>
            </Border>
            <Label Text="Анкета" FontSize="20" FontAttributes="Bold" TextColor="#2B2D42" VerticalOptions="Center"/>
        </HorizontalStackLayout>

        <!-- ПРОКРУЧИВАЕМОЕ СОДЕРЖИМОЕ -->
        <ScrollView Grid.Row="1">
            <VerticalStackLayout Spacing="15">

                <!-- Фото -->
                <Border StrokeShape="RoundRectangle 20" HeightRequest="200" StrokeThickness="0">
                    <Image Source="{Binding ImagePath}" Aspect="AspectFill" />
                </Border>

                <!-- ИМЯ -->
                <Label Text="{Binding Name}" FontSize="32" FontAttributes="Bold" TextColor="#2B2D42" Margin="0,10,0,0"/>

                <!-- ХАРАКТЕРИСТИКИ (Вид, Возраст, Пол, Размер) -->
                <Grid ColumnDefinitions="*, *" RowDefinitions="Auto, Auto" ColumnSpacing="10" RowSpacing="8" Margin="0,0,0,10">

                    <!-- Вид -->
                    <HorizontalStackLayout Grid.Row="0" Grid.Column="0" Spacing="5">
                        <Label Text="Вид:" FontSize="14" TextColor="#6C757D"/>
                        <Label Text="{Binding Type}" FontSize="14" FontAttributes="Bold" TextColor="#2B2D42"/>
                    </HorizontalStackLayout>

                    <!-- Возраст -->
                    <HorizontalStackLayout Grid.Row="0" Grid.Column="1" Spacing="5">
                        <Label Text="Возраст:" FontSize="14" TextColor="#6C757D"/>
                        <Label Text="{Binding Age}" FontSize="14" FontAttributes="Bold" TextColor="#2B2D42"/>
                    </HorizontalStackLayout>

                    <!-- Пол -->
                    <HorizontalStackLayout Grid.Row="1" Grid.Column="0" Spacing="5">
                        <Label Text="Пол:" FontSize="14" TextColor="#6C757D"/>
                        <Label Text="{Binding Gender}" FontSize="14" FontAttributes="Bold" TextColor="#2B2D42"/>
                    </HorizontalStackLayout>

                    <!-- Размер -->
                    <HorizontalStackLayout Grid.Row="1" Grid.Column="1" Spacing="5">
                        <Label Text="Размер:" FontSize="14" TextColor="#6C757D"/>
                        <Label Text="{Binding Size}" FontSize="14" FontAttributes="Bold" TextColor="#2B2D42"/>
                    </HorizontalStackLayout>

                </Grid>

                <!-- Теги -->
                <FlexLayout Wrap="Wrap">
                    <Border StrokeShape="RoundRectangle 10" BackgroundColor="#FCEAC2" Padding="10,4" Margin="0,0,5,5">
                        <Label Text="{Binding Tag1}" FontSize="12"/>
                    </Border>
                    <Border StrokeShape="RoundRectangle 10" BackgroundColor="#FCEAC2" Padding="10,4" Margin="0,0,5,5">
                        <Label Text="{Binding Tag2}" FontSize="12"/>
                    </Border>
                    <Border StrokeShape="RoundRectangle 10" BackgroundColor="#FCEAC2" Padding="10,4" Margin="0,0,5,5">
                        <Label Text="{Binding Tag3}" FontSize="12"/>
                    </Border>
                </FlexLayout>

                <!-- История -->
                <Border StrokeShape="RoundRectangle 15" StrokeThickness="1" Stroke="#EAEAEA" BackgroundColor="White" Padding="15" Margin="0,10,0,0">
                    <VerticalStackLayout Spacing="5">
                        <Label Text="История" FontSize="16" FontAttributes="Bold" TextColor="#2B2D42"/>
                        <Label Text="{Binding History}" FontSize="14" TextColor="#6C757D"/>
                    </VerticalStackLayout>
                </Border>

                <!-- Характер -->
                <Border StrokeShape="RoundRectangle 15" StrokeThickness="1" Stroke="#EAEAEA" BackgroundColor="White" Padding="15">
                    <VerticalStackLayout Spacing="5">
                        <Label Text="Характер" FontSize="16" FontAttributes="Bold" TextColor="#2B2D42"/>
                        <Label Text="{Binding Character}" FontSize="14" TextColor="#6C757D"/>
                    </VerticalStackLayout>
                </Border>

                <!-- Требования к хозяину -->
                <Border StrokeShape="RoundRectangle 15" StrokeThickness="1" Stroke="#EAEAEA" BackgroundColor="White" Padding="15">
                    <VerticalStackLayout Spacing="5">
                        <Label Text="Требования к хозяину" FontSize="16" FontAttributes="Bold" TextColor="#2B2D42"/>
                        <Label Text="{Binding Requirements}" FontSize="14" TextColor="#6C757D"/>
                    </VerticalStackLayout>
                </Border>

                <!-- Контакты приюта -->
                <Border StrokeShape="RoundRectangle 15" StrokeThickness="1" Stroke="#EAEAEA" BackgroundColor="White" Padding="15" Margin="0,10,0,10">
                    <VerticalStackLayout Spacing="5">
                        <Label Text="Контакты приюта" FontSize="16" FontAttributes="Bold" TextColor="#2B2D42"/>
                        <Label Text="📍 г. Москва, ул. Приютская, д. 10" FontSize="14" TextColor="#6C757D"/>
                        <Label Text="📞 +7 (999) 123-45-67" FontSize="14" TextColor="#6C757D"/>
                        <Label Text="🕒 Ежедневно с 10:00 до 19:00" FontSize="14" TextColor="#6C757D"/>
                    </VerticalStackLayout>
                </Border>

            </VerticalStackLayout>
        </ScrollView>

        <!-- НИЖНИЕ КНОПКИ -->
        <VerticalStackLayout Grid.Row="2" Spacing="10" Margin="0,15,0,0">
            <Border StrokeShape="RoundRectangle 20" BackgroundColor="#B84A00" Padding="15">
                <Label Text="Хочу познакомиться" TextColor="White" FontAttributes="Bold" HorizontalOptions="Center" FontSize="16"/>
            </Border>

            <Border StrokeShape="RoundRectangle 20" Stroke="#B84A00" StrokeThickness="1" BackgroundColor="Transparent" Padding="15">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnReadMemoClicked" />
                </Border.GestureRecognizers>
                <Label Text="Сначала прочитать памятку" TextColor="#B84A00" FontAttributes="Bold" HorizontalOptions="Center" FontSize="16"/>
            </Border>
        </VerticalStackLayout>

    </Grid>
</ContentPage>