<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Way_to_home.PetDetailsPage"
             BackgroundColor="#FEF8EE"
             Shell.NavBarIsVisible="False">

    <Grid RowDefinitions="Auto, *, Auto" Padding="20, 30, 20, 20">

        <!-- Шапка со стрелкой -->
        <HorizontalStackLayout Grid.Row="0" Spacing="15" Margin="0,0,0,10">
            <Border StrokeShape="RoundRectangle 20" StrokeThickness="1" Stroke="#E0E0E0" BackgroundColor="White" WidthRequest="40" HeightRequest="40" Padding="0">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnBackClicked" />
                </Border.GestureRecognizers>
                <Label Text="&lt;" FontSize="20" TextColor="#2B2D42" HorizontalOptions="Center" VerticalOptions="Center"/>
            </Border>
            <Label Text="Анкета" FontSize="20" FontAttributes="Bold" TextColor="#2B2D42" VerticalOptions="Center"/>
        </HorizontalStackLayout>

        <ScrollView Grid.Row="1">
            <VerticalStackLayout Spacing="15">

                <!-- КАРТИНКА (Если серая - значит файл не найден) -->
                <Image Source="{Binding ImagePath}" HeightRequest="250" Aspect="AspectFill" BackgroundColor="#E0E0E0" />

                <!-- ИМЯ -->
                <Label Text="{Binding Name}" FontSize="28" FontAttributes="Bold" TextColor="#2B2D42"/>

                <!-- ВИД, ВОЗРАСТ, ПОЛ, РАЗМЕР -->
                <Grid ColumnDefinitions="*, *" RowDefinitions="Auto, Auto" RowSpacing="5">
                    <Label Grid.Row="0" Grid.Column="0" Text="{Binding Type, StringFormat='Вид: {0}'}" TextColor="#6C757D"/>
                    <Label Grid.Row="0" Grid.Column="1" Text="{Binding Age, StringFormat='Возраст: {0}'}" TextColor="#6C757D"/>
                    <Label Grid.Row="1" Grid.Column="0" Text="{Binding Gender, StringFormat='Пол: {0}'}" TextColor="#6C757D"/>
                    <Label Grid.Row="1" Grid.Column="1" Text="{Binding Size, StringFormat='Размер: {0}'}" TextColor="#6C757D"/>
                </Grid>

                <!-- ТЕГИ -->
                <HorizontalStackLayout Spacing="10" Margin="0,5,0,5">
                    <Border StrokeShape="RoundRectangle 15" BackgroundColor="#F4E8D3" Padding="12,6">
                        <Label Text="{Binding Tag1}" TextColor="#B84A00" FontSize="12"/>
                    </Border>
                    <Border StrokeShape="RoundRectangle 15" BackgroundColor="#F4E8D3" Padding="12,6">
                        <Label Text="{Binding Tag2}" TextColor="#B84A00" FontSize="12"/>
                    </Border>
                    <Border StrokeShape="RoundRectangle 15" BackgroundColor="#F4E8D3" Padding="12,6">
                        <Label Text="{Binding Tag3}" TextColor="#B84A00" FontSize="12"/>
                    </Border>
                </HorizontalStackLayout>

                <!-- ИСТОРИЯ -->
                <Border StrokeShape="RoundRectangle 15" Stroke="#E0E0E0" StrokeThickness="1" BackgroundColor="White" Padding="15">
                    <VerticalStackLayout Spacing="5">
                        <Label Text="История" FontAttributes="Bold" FontSize="16" TextColor="#2B2D42"/>
                        <Label Text="{Binding History}" TextColor="#6C757D" FontSize="14"/>
                    </VerticalStackLayout>
                </Border>

                <!-- ХАРАКТЕР -->
                <Border StrokeShape="RoundRectangle 15" Stroke="#E0E0E0" StrokeThickness="1" BackgroundColor="White" Padding="15">
                    <VerticalStackLayout Spacing="5">
                        <Label Text="Характер" FontAttributes="Bold" FontSize="16" TextColor="#2B2D42"/>
                        <Label Text="{Binding Character}" TextColor="#6C757D" FontSize="14"/>
                    </VerticalStackLayout>
                </Border>

                <!-- ТРЕБОВАНИЯ -->
                <Border StrokeShape="RoundRectangle 15" Stroke="#E0E0E0" StrokeThickness="1" BackgroundColor="White" Padding="15">
                    <VerticalStackLayout Spacing="5">
                        <Label Text="Требования к хозяину" FontAttributes="Bold" FontSize="16" TextColor="#2B2D42"/>
                        <Label Text="{Binding Requirements}" TextColor="#6C757D" FontSize="14"/>
                    </VerticalStackLayout>
                </Border>

            </VerticalStackLayout>
        </ScrollView>

        <!-- КНОПКИ -->
        <VerticalStackLayout Grid.Row="2" Spacing="10" Margin="0,15,0,0">

            <!-- Кнопка 1 -->
            <Button Text="Хочу познакомиться" 
                    Clicked="OnAdoptClicked" 
                    BackgroundColor="#B84A00" TextColor="White" FontAttributes="Bold" CornerRadius="20" HeightRequest="50" />

            <!-- Кнопка 2 -->
            <Button Text="Сначала прочитать памятку" 
                    Clicked="OnMemoClicked"
                    BackgroundColor="Transparent" TextColor="#B84A00" BorderColor="#B84A00" BorderWidth="1" CornerRadius="20" HeightRequest="50" />

        </VerticalStackLayout>

    </Grid>
</ContentPage>