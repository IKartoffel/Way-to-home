<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="Way_to_home.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:Way_to_home"
    Shell.FlyoutBehavior="Disabled"
    Title="Way to home">

    <TabBar>
        <ShellContent Title="Животные" Icon="paw.png" ContentTemplate="{DataTemplate local:AnimalsPage}" Route="AnimalsPage" />
        <ShellContent Title="Памятки" Icon="memo.png" ContentTemplate="{DataTemplate local:MemoPage}" Route="MemoPage" />
        <ShellContent Title="Как помочь" Icon="heart.png" ContentTemplate="{DataTemplate local:HelpPage}" Route="HelpPage" />
    </TabBar>
</Shell>