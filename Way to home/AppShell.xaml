<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="Way_to_home.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:Way_to_home"
    Shell.FlyoutBehavior="Disabled"
    Title="Way to home">

    <TabBar>
        <!-- 1. Главная страница (HomePage) - стоит первой, значит с неё начнется запуск -->
        <ShellContent
            Title="Главная"
            Icon="home.png" 
            ContentTemplate="{DataTemplate local:HomePage}"
            Route="HomePage" />

        <!-- 2. Животные -->
        <ShellContent
            Title="Животные"
            Icon="paw.png" 
            ContentTemplate="{DataTemplate local:AnimalsPage}"
            Route="AnimalsPage" />

        <!-- 3. Памятки -->
        <ShellContent
            Title="Памятки"
            Icon="memo.png" 
            ContentTemplate="{DataTemplate local:MemoPage}"
            Route="MemoPage" />

        <!-- 4. Как помочь -->
        <ShellContent
            Title="Как помочь"
            Icon="heart.png" 
            ContentTemplate="{DataTemplate local:HelpPage}"
            Route="HelpPage" />
    </TabBar>
</Shell>