<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Way_to_home.ChecklistPage"
             BackgroundColor="#FEF8EE"
             Shell.NavBarIsVisible="False">

    <Grid RowDefinitions="Auto, *" Padding="20, 30, 20, 20">

        <!-- Шапка с кнопкой Назад -->
        <HorizontalStackLayout Grid.Row="0" Spacing="15" Margin="0,0,0,20">
            <Border StrokeShape="RoundRectangle 20" StrokeThickness="1" Stroke="#E0E0E0" BackgroundColor="White" WidthRequest="40" HeightRequest="40" Padding="0">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnBackClicked" />
                </Border.GestureRecognizers>
                <Label Text="&lt;" FontSize="20" TextColor="#2B2D42" HorizontalOptions="Center" VerticalOptions="Center"/>
            </Border>
            <Label Text="Чек-лист" FontSize="20" FontAttributes="Bold" TextColor="#2B2D42" VerticalOptions="Center"/>
        </HorizontalStackLayout>

        <ScrollView Grid.Row="1">
            <VerticalStackLayout Spacing="20">
                <Label Text="Я готов(а) к ответственности?" FontSize="22" FontAttributes="Bold" TextColor="#2B2D42"/>
                <Label Text="Отметьте все пункты, чтобы быть уверенным в своем решении." FontSize="14" TextColor="#6C757D"/>

                <!-- Пункты чек-листа -->
                <Border StrokeShape="RoundRectangle 15" Stroke="#E0E0E0" StrokeThickness="1" BackgroundColor="White" Padding="10">
                    <VerticalStackLayout Spacing="15">

                        <HorizontalStackLayout Spacing="10">
                            <CheckBox Color="#B84A00"/>
                            <Label Text="Я готов к финансовым расходам" VerticalOptions="Center" TextColor="#2B2D42"/>
                        </HorizontalStackLayout>

                        <HorizontalStackLayout Spacing="10">
                            <CheckBox Color="#B84A00"/>
                            <Label Text="У меня есть время на прогулки и уход" VerticalOptions="Center" TextColor="#2B2D42"/>
                        </HorizontalStackLayout>

                        <HorizontalStackLayout Spacing="10">
                            <CheckBox Color="#B84A00"/>
                            <Label Text="Жилищные условия позволяют" VerticalOptions="Center" TextColor="#2B2D42"/>
                        </HorizontalStackLayout>

                        <HorizontalStackLayout Spacing="10">
                            <CheckBox Color="#B84A00"/>
                            <Label Text="Все члены семьи согласны" VerticalOptions="Center" TextColor="#2B2D42"/>
                        </HorizontalStackLayout>

                        <HorizontalStackLayout Spacing="10">
                            <CheckBox Color="#B84A00"/>
                            <Label Text="Я готов к трудностям адаптации" VerticalOptions="Center" TextColor="#2B2D42"/>
                        </HorizontalStackLayout>

                    </VerticalStackLayout>
                </Border>

                <!-- Кнопка завершения -->
                <Button Text="Завершить" 
                        BackgroundColor="#B84A00" 
                        TextColor="White" 
                        FontAttributes="Bold" 
                        CornerRadius="20" 
                        HeightRequest="50"
                        Margin="0,20,0,0"
                        Clicked="OnFinishClicked"/>
            </VerticalStackLayout>
        </ScrollView>

    </Grid>
</ContentPage>