<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Way_to_home.FiltersPage"
             BackgroundColor="#FEF8EE"
             Shell.NavBarIsVisible="False">

    <Grid RowDefinitions="Auto, *, Auto" Padding="20, 30, 20, 20">

        <!-- ШАПКА С КНОПКОЙ НАЗАД -->
        <HorizontalStackLayout Grid.Row="0" Spacing="15" Margin="0,0,0,20">
            <Border StrokeShape="RoundRectangle 20" StrokeThickness="1" Stroke="#E0E0E0" BackgroundColor="White" WidthRequest="40" HeightRequest="40" Padding="0">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnBackClicked" />
                </Border.GestureRecognizers>
                <Label Text="&lt;" FontSize="20" TextColor="#2B2D42" HorizontalOptions="Center" VerticalOptions="Center"/>
            </Border>
            <Label Text="Фильтры" FontSize="20" FontAttributes="Bold" TextColor="#2B2D42" VerticalOptions="Center"/>
        </HorizontalStackLayout>

        <!-- СПИСОК ФИЛЬТРОВ -->
        <ScrollView Grid.Row="1">
            <VerticalStackLayout Spacing="25">

                <!-- Вид -->
                <VerticalStackLayout Spacing="10">
                    <Label Text="Вид" FontAttributes="Bold" TextColor="#2B2D42" FontSize="16"/>
                    <FlexLayout Wrap="Wrap" JustifyContent="Start" AlignItems="Start">

                        <!-- Чип "Все" -->
                        <Border x:Name="ChipTypeAll" StrokeShape="RoundRectangle 20" Stroke="#D1D1D1" StrokeThickness="1" BackgroundColor="Transparent" Padding="15,8" Margin="0,0,10,10">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnTypeFilterTapped" CommandParameter="Все" />
                            </Border.GestureRecognizers>
                            <Label Text="Все" TextColor="#2B2D42"/>
                        </Border>

                        <!-- Чип "Собаки" -->
                        <Border x:Name="ChipTypeDogs" StrokeShape="RoundRectangle 20" Stroke="#D1D1D1" StrokeThickness="1" Padding="15,8" Margin="0,0,10,10" BackgroundColor="Transparent">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnTypeFilterTapped" CommandParameter="Собаки" />
                            </Border.GestureRecognizers>
                            <Label Text="Собаки" TextColor="#2B2D42"/>
                        </Border>

                        <!-- Чип "Коты" -->
                        <Border x:Name="ChipTypeCats" StrokeShape="RoundRectangle 20" Stroke="#D1D1D1" StrokeThickness="1" Padding="15,8" Margin="0,0,10,10" BackgroundColor="Transparent">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnTypeFilterTapped" CommandParameter="Коты" />
                            </Border.GestureRecognizers>
                            <Label Text="Коты" TextColor="#2B2D42"/>
                        </Border>
                    </FlexLayout>
                </VerticalStackLayout>

                <!-- Возраст -->
                <VerticalStackLayout Spacing="10">
                    <Label Text="Возраст" FontAttributes="Bold" TextColor="#2B2D42" FontSize="16"/>
                    <FlexLayout Wrap="Wrap">

                        <!-- Чип "Любой" -->
                        <Border x:Name="ChipAgeAny" StrokeShape="RoundRectangle 20" Stroke="#D1D1D1" StrokeThickness="1" BackgroundColor="Transparent" Padding="15,8" Margin="0,0,10,10">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnAgeFilterTapped" CommandParameter="Любой" />
                            </Border.GestureRecognizers>
                            <Label Text="Любой" TextColor="#2B2D42"/>
                        </Border>

                        <!-- Чип "До 1 года" -->
                        <Border x:Name="ChipAgeUpTo1" StrokeShape="RoundRectangle 20" Stroke="#D1D1D1" StrokeThickness="1" Padding="15,8" Margin="0,0,10,10" BackgroundColor="Transparent">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnAgeFilterTapped" CommandParameter="До 1 года" />
                            </Border.GestureRecognizers>
                            <Label Text="До 1 года" TextColor="#2B2D42"/>
                        </Border>

                        <!-- Чип "1–7 лет" -->
                        <Border x:Name="ChipAge1To7" StrokeShape="RoundRectangle 20" Stroke="#D1D1D1" StrokeThickness="1" Padding="15,8" Margin="0,0,10,10" BackgroundColor="Transparent">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnAgeFilterTapped" CommandParameter="1–7 лет" />
                            </Border.GestureRecognizers>
                            <Label Text="1–7 лет" TextColor="#2B2D42"/>
                        </Border>

                        <!-- Чип "Старше 7" -->
                        <Border x:Name="ChipAgeOver7" StrokeShape="RoundRectangle 20" Stroke="#D1D1D1" StrokeThickness="1" Padding="15,8" Margin="0,0,10,10" BackgroundColor="Transparent">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnAgeFilterTapped" CommandParameter="Старше 7" />
                            </Border.GestureRecognizers>
                            <Label Text="Старше 7" TextColor="#2B2D42"/>
                        </Border>
                    </FlexLayout>
                </VerticalStackLayout>

                <!-- Размер -->
                <VerticalStackLayout Spacing="10">
                    <Label Text="Размер" FontAttributes="Bold" TextColor="#2B2D42" FontSize="16"/>
                    <FlexLayout Wrap="Wrap">

                        <!-- Чип "Любой" -->
                        <Border x:Name="ChipSizeAny" StrokeShape="RoundRectangle 20" Stroke="#D1D1D1" StrokeThickness="1" BackgroundColor="Transparent" Padding="15,8" Margin="0,0,10,10">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnSizeFilterTapped" CommandParameter="Любой" />
                            </Border.GestureRecognizers>
                            <Label Text="Любой" TextColor="#2B2D42"/>
                        </Border>

                        <!-- Чип "Малый" -->
                        <Border x:Name="ChipSizeSmall" StrokeShape="RoundRectangle 20" Stroke="#D1D1D1" StrokeThickness="1" Padding="15,8" Margin="0,0,10,10" BackgroundColor="Transparent">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnSizeFilterTapped" CommandParameter="Малый" />
                            </Border.GestureRecognizers>
                            <Label Text="Малый" TextColor="#2B2D42"/>
                        </Border>

                        <!-- Чип "Средний" -->
                        <Border x:Name="ChipSizeMedium" StrokeShape="RoundRectangle 20" Stroke="#D1D1D1" StrokeThickness="1" Padding="15,8" Margin="0,0,10,10" BackgroundColor="Transparent">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnSizeFilterTapped" CommandParameter="Средний" />
                            </Border.GestureRecognizers>
                            <Label Text="Средний" TextColor="#2B2D42"/>
                        </Border>

                        <!-- Чип "Крупный" -->
                        <Border x:Name="ChipSizeLarge" StrokeShape="RoundRectangle 20" Stroke="#D1D1D1" StrokeThickness="1" Padding="15,8" Margin="0,0,10,10" BackgroundColor="Transparent">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnSizeFilterTapped" CommandParameter="Крупный" />
                            </Border.GestureRecognizers>
                            <Label Text="Крупный" TextColor="#2B2D42"/>
                        </Border>
                    </FlexLayout>
                </VerticalStackLayout>

            </VerticalStackLayout>
        </ScrollView>

        <!-- НИЖНИЕ КНОПКИ -->
        <VerticalStackLayout Grid.Row="2" Spacing="10" Margin="0,20,0,0">
            <!-- Кнопка Показать -->
            <Border StrokeShape="RoundRectangle 20" BackgroundColor="#B84A00" Padding="15" StrokeThickness="0">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnApplyFiltersClicked" />
                </Border.GestureRecognizers>
                <Label Text="Показать анкеты" TextColor="White" FontAttributes="Bold" HorizontalOptions="Center" FontSize="16"/>
            </Border>

            <!-- Кнопка Сбросить -->
            <Border StrokeShape="RoundRectangle 20" Stroke="#B84A00" StrokeThickness="1" BackgroundColor="Transparent" Padding="15">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnResetFiltersClicked" />
                </Border.GestureRecognizers>
                <Label Text="Сбросить" TextColor="#B84A00" FontAttributes="Bold" HorizontalOptions="Center" FontSize="16"/>
            </Border>
        </VerticalStackLayout>

    </Grid>
</ContentPage>