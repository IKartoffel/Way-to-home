<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Way_to_home.MemoPage"
             BackgroundColor="#FEF8EE"
             Shell.NavBarIsVisible="False">

    <Grid RowDefinitions="Auto, *" Padding="20, 30, 20, 20">

        <!-- Кнопка назад -->
        <HorizontalStackLayout Grid.Row="0" Spacing="15" Margin="0,0,0,20">
            <Border StrokeShape="RoundRectangle 20" StrokeThickness="1" Stroke="#E0E0E0" BackgroundColor="White" WidthRequest="40" HeightRequest="40" Padding="0">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnBackClicked" />
                </Border.GestureRecognizers>
                <Label Text="&lt;" FontSize="20" TextColor="#2B2D42" HorizontalOptions="Center" VerticalOptions="Center"/>
            </Border>
            <Label Text="Памятка" FontSize="20" FontAttributes="Bold" TextColor="#2B2D42" VerticalOptions="Center"/>
        </HorizontalStackLayout>

        <!-- Контент -->
        <ScrollView Grid.Row="1">
            <VerticalStackLayout Spacing="15">

                <Label Text="Что нужно знать до того, как взять питомца" 
                       FontSize="22" FontAttributes="Bold" TextColor="#2B2D42" Margin="0,0,0,10"/>

                <!-- Карточка 1 -->
                <Border StrokeShape="RoundRectangle 15" StrokeThickness="1" Stroke="#EAEAEA" BackgroundColor="White" Padding="15">
                    <VerticalStackLayout Spacing="5">
                        <Grid ColumnDefinitions="*, Auto">
                            <Label Text="Расходы" FontSize="16" FontAttributes="Bold" TextColor="#2B2D42"/>
                            <Label Grid.Column="1" Text="Подробнее" FontSize="14" TextColor="#B84A00" FontAttributes="Bold"/>
                        </Grid>
                        <Label Text="Корм, ветеринар, прививки. Ориентир в месяц: [сумма]." FontSize="14" TextColor="#6C757D"/>
                    </VerticalStackLayout>
                </Border>

                <!-- Карточка 2 -->
                <Border StrokeShape="RoundRectangle 15" StrokeThickness="1" Stroke="#EAEAEA" BackgroundColor="White" Padding="15">
                    <VerticalStackLayout Spacing="5">
                        <Grid ColumnDefinitions="*, Auto">
                            <Label Text="Время и режим" FontSize="16" FontAttributes="Bold" TextColor="#2B2D42"/>
                            <Label Grid.Column="1" Text="Подробнее" FontSize="14" TextColor="#B84A00" FontAttributes="Bold"/>
                        </Grid>
                        <Label Text="Прогулки, кормление, уход. Нужно: [часов в день]." FontSize="14" TextColor="#6C757D"/>
                    </VerticalStackLayout>
                </Border>

                <!-- Карточка 3 -->
                <Border StrokeShape="RoundRectangle 15" StrokeThickness="1" Stroke="#EAEAEA" BackgroundColor="White" Padding="15">
                    <VerticalStackLayout Spacing="5">
                        <Grid ColumnDefinitions="*, Auto">
                            <Label Text="Дом и безопасность" FontSize="16" FontAttributes="Bold" TextColor="#2B2D42"/>
                            <Label Grid.Column="1" Text="Подробнее" FontSize="14" TextColor="#B84A00" FontAttributes="Bold"/>
                        </Grid>
                        <Label Text="Что подготовить до появления питомца: [список]." FontSize="14" TextColor="#6C757D"/>
                    </VerticalStackLayout>
                </Border>

                <!-- Карточка 4 -->
                <Border StrokeShape="RoundRectangle 15" StrokeThickness="1" Stroke="#EAEAEA" BackgroundColor="White" Padding="15">
                    <VerticalStackLayout Spacing="5">
                        <Grid ColumnDefinitions="*, Auto">
                            <Label Text="Здоровье" FontSize="16" FontAttributes="Bold" TextColor="#2B2D42"/>
                            <Label Grid.Column="1" Text="Подробнее" FontSize="14" TextColor="#B84A00" FontAttributes="Bold"/>
                        </Grid>
                        <Label Text="Прививки, стерилизация, визиты к врачу: [памятка]." FontSize="14" TextColor="#6C757D"/>
                    </VerticalStackLayout>
                </Border>

                <!-- Блок чек-листа -->
                <Border StrokeShape="RoundRectangle 20" BackgroundColor="#FCEAC2" Padding="20" Margin="0,15,0,0">
                    <VerticalStackLayout Spacing="15">
                        <Button Text="Пройти чек-лист" 
        Clicked="OnChecklistClicked" 
        BackgroundColor="#B84A00" 
        TextColor="White" 
        CornerRadius="20" 
        HeightRequest="50" />
                        <Label Text="Я готов(а) к ответственности?" FontSize="18" FontAttributes="Bold" TextColor="#2B2D42"/>
                        <Label Text="Короткий чек-лист из 5 пунктов." FontSize="14" TextColor="#6C757D"/>
                        <Border StrokeShape="RoundRectangle 15" BackgroundColor="#B84A00" Padding="15" Margin="0,5,0,0">
                            <Label Text="Пройти чек-лист" TextColor="White" FontAttributes="Bold" HorizontalOptions="Center" FontSize="16"/>
                        </Border>
                    </VerticalStackLayout>
                </Border>

            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>