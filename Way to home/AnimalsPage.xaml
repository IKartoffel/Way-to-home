<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Way_to_home.AnimalsPage"
             BackgroundColor="#FEF8EE"
             Shell.NavBarIsVisible="False">

    <!-- Основная сетка: строка Auto для шапки, строка * для списка -->
    <Grid RowDefinitions="Auto, *" Padding="20, 30, 20, 20">

        <!-- ВЕРХНЯЯ ЧАСТЬ (Шапка) -->
        <VerticalStackLayout Grid.Row="0" Spacing="20" Margin="0,0,0,10">

            <!-- СТРЕЛКА НАЗАД И ЗАГОЛОВОК -->
            <HorizontalStackLayout Spacing="15">
                <Border StrokeShape="RoundRectangle 20" StrokeThickness="1" Stroke="#E0E0E0" BackgroundColor="White" WidthRequest="40" HeightRequest="40" Padding="0" VerticalOptions="Center">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnBackClicked" />
                    </Border.GestureRecognizers>
                    <Label Text="&lt;" FontSize="20" TextColor="#2B2D42" HorizontalOptions="Center" VerticalOptions="Center"/>
                </Border>
            </HorizontalStackLayout>

            <!-- ЗАГОЛОВОК -->
            <VerticalStackLayout Spacing="5" Margin="0,-10,0,0">
                <Label Text="Найди друга" FontSize="26" FontAttributes="Bold" TextColor="#2B2D42"/>
                <Label Text="Подробные анкеты животных из приюта" FontSize="14" TextColor="#6C757D"/>
            </VerticalStackLayout>

            <!-- ФИЛЬТРЫ -->
            <Border StrokeShape="RoundRectangle 20" BackgroundColor="Transparent" Stroke="#D1D1D1" StrokeThickness="1" Padding="15,8" HorizontalOptions="Start">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnFiltersClicked" />
                </Border.GestureRecognizers>
                <Label Text="Фильтры" TextColor="#2B2D42" FontSize="14"/>
            </Border>

            <!-- СТРОКА СОРТИРОВКИ -->
            <Grid ColumnDefinitions="*, Auto">
                <Label Grid.Column="0" Text="{Binding FilteredPetsCount, StringFormat='Найдено анкет: {0}'}" TextColor="#6C757D" FontSize="14" VerticalOptions="Center"/>
                <HorizontalStackLayout Grid.Column="1" Spacing="5" VerticalOptions="Center">
                    <Label Text="≡" TextColor="#B84A00" FontSize="18" FontAttributes="Bold"/>
                    <Label Text="Сортировка" TextColor="#B84A00" FontSize="14" FontAttributes="Bold"/>
                </HorizontalStackLayout>
            </Grid>

        </VerticalStackLayout>

        <!-- СПИСОК КАРТОЧЕК -->
        <CollectionView Grid.Row="1" x:Name="PetsCollectionView" ItemsSource="{Binding FilteredPets}">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Border StrokeShape="RoundRectangle 15" Stroke="#E0E0E0"
                            BackgroundColor="White" Padding="15" Margin="0,5,0,5">

                        <!-- Обработчик нажатия на карточку -->
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnPetTapped" />
                        </Border.GestureRecognizers>

                        <!-- Правильная сетка: Картинка слева, текст справа -->
                        <Grid ColumnDefinitions="Auto, *">

                            <!-- Картинка -->
                            <Image Source="{Binding ImagePath}" 
                                   WidthRequest="80" HeightRequest="80" 
                                   Aspect="AspectFill" />

                            <!-- Текст -->
                            <VerticalStackLayout Grid.Column="1" Spacing="4" Margin="15,0,0,0" VerticalOptions="Center">
                                <Label Text="{Binding Name}" FontAttributes="Bold" FontSize="18" />
                                <Label FontSize="14" TextColor="#8D99AE">
                                    <Label.FormattedText>
                                        <FormattedString>
                                            <Span Text="{Binding Type}" />
                                            <Span Text=" • " />
                                            <Span Text="{Binding Age}" />
                                            <Span Text=" • " />
                                            <Span Text="{Binding Size}" />
                                        </FormattedString>
                                    </Label.FormattedText>
                                </Label>
                            </VerticalStackLayout>

                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

    </Grid>
</ContentPage>